{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/v1/explain", "destination": "/api/explain.js" },
    { "source": "/api/v1/health", "destination": "/api/health.js" },
    { "source": "/api/v1/history/(.*)", "destination": "/api/history.js" },
    { "source": "/api/v1/history", "destination": "/api/history.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
